# SVM V11.2V Environment
# Made by AnkitCoder
# Copy to .env or /etc/svm-v11.2v/svm.env and chmod 600

DISCORD_TOKEN=
BOT_NAME=SVM V11.2V
PREFIX=!
YOUR_SERVER_IP=127.0.0.1
MAIN_ADMIN_ID=
VPS_USER_ROLE_ID=
DEFAULT_STORAGE_POOL=default
BOT_VERSION=11.2V
BOT_DEVELOPER=AnkitCoder
BOT_THUMBNAIL_URL=https://i.imgur.com/xAx2gRQ.jpeg
BOT_ICON_URL=https://i.imgur.com/xAx2gRQ.jpeg

DEFAULT_VPS_EXPIRATION_DAYS=30
EXPIRATION_WARNING_DAYS=1
HOST_MOTD=

# Public VPS Creation
PUBLIC_VPS_ENABLED=true
PUBLIC_VPS_MAX_RAM=4
PUBLIC_VPS_MAX_CPU=2
PUBLIC_VPS_MAX_DISK=50
PUBLIC_VPS_EXPIRY_DAYS=30
PUBLIC_VPS_MAX_PER_USER=1
PUBLIC_VPS_MAX_PER_IP=1
PUBLIC_VPS_REQUIRE_VERIFICATION=false
PUBLIC_VPS_RENEWAL_ENABLED=true
PUBLIC_VPS_RENEWAL_DAYS=30

# Web SSH Terminal
WEBSSH_ENABLED=true
WEBSSH_PORT=5000
WEBSSH_SERVER_IP=127.0.0.1
WEBSSH_URL_FORMAT=http://{SERVER_IP}:{PORT}

# Provider
SVM_PROVIDER_MODE=lxc
SVM_DATA_DIR=/var/lib/svm-v11.2v
SVM_LOG_DIR=/var/log/svm-v11.2v
SVM_DB_PATH=/var/lib/svm-v11.2v/vps.db

# Libvirt / KVM
LIBVIRT_URI=qemu:///system
LIBVIRT_NETWORK=default
SVM_IMAGES_DIR=/var/lib/svm-v11.2v/images
SVM_VMS_DIR=/var/lib/svm-v11.2v/vms
SVM_CLOUDINIT_DIR=/var/lib/svm-v11.2v/cloud-init
